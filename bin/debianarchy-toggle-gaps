#!/bin/bash
# Toggle window gaps and borders on/off for the session

if [[ $(hyprctl getoption general:gaps_out -j | jq -r '.custom' | awk '{print $1}') == 0 ]]; then
  hyprctl reload >/dev/null
else
  hyprctl --batch "keyword general:gaps_out 0; keyword general:gaps_in 0; keyword general:border_size 0" >/dev/null
fi
