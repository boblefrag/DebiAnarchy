#!/bin/bash
# Searchable list of every bindd (described) keybinding

hyprctl binds -j | jq -r '
  def mods: [
    (if . % 128 >= 64 then "SUPER" else empty end),
    (if . % 16 >= 8 then "ALT" else empty end),
    (if . % 8 >= 4 then "CTRL" else empty end),
    (if . % 2 >= 1 then "SHIFT" else empty end)
  ] | join(" + ");
  .[] | select(.has_description) |
  "\((.modmask | mods) as $m | if $m == "" then "" else $m + " + " end)\(.key)\t→ \(.description)"' |
  column -t -s $'\t' | debianarchy-dmenu "Keys › " 20 >/dev/null
