#!/bin/bash
# Launch the default browser as determined by xdg-settings.
# Usage: debianarchy-launch-browser [--private] [url]

default_browser=$(xdg-settings get default-web-browser)
browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,/usr}/share/applications/$default_browser 2>/dev/null | head -1)
browser_exec=${browser_exec:-chromium}

if $browser_exec --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
else
  private_flag="--incognito"
fi

exec setsid uwsm-app -- "$browser_exec" "${@/--private/$private_flag}"
