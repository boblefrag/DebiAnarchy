#!/bin/bash
# One-time tasks on the first Hyprland login

MARKER="$HOME/.local/state/debianarchy/first-run.done"
[[ -f $MARKER ]] && exit 0
mkdir -p "$(dirname "$MARKER")"

# Theme must be rendered before anything themed shows up
[[ -f $HOME/.config/debianarchy/current/theme.name ]] || debianarchy-theme-set tokyo-night

xdg-settings set default-web-browser chromium.desktop 2>/dev/null || true
xdg-mime default org.gnome.Nautilus.desktop inode/directory 2>/dev/null || true
xdg-mime default imv.desktop image/png image/jpeg image/gif image/webp 2>/dev/null || true
xdg-mime default mpv.desktop video/mp4 video/x-matroska video/webm 2>/dev/null || true
xdg-mime default org.gnome.Papers.desktop application/pdf 2>/dev/null || true

notify-send -u critical "Welcome to DebiAnarchy" "Super+Space: apps · Super+Alt+Space: menu · Super+K: keybindings"
touch "$MARKER"
