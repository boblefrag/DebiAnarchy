# Editor used by CLI
export EDITOR=nvim
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Duplicated from .config/uwsm/env so SSH works too
export DEBIANARCHY_PATH=$HOME/.local/share/debianarchy
export PATH=$DEBIANARCHY_PATH/bin:$PATH:$HOME/.local/bin:$HOME/.cargo/bin
